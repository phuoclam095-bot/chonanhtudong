    <script>
        const GOOGLE_CONFIG = {
            CLIENT_ID: '781143890416-3hsl3fii3is9r7fl6m55gsuuulcteiq8.apps.googleusercontent.com', 
            N8N_OAUTH_REDIRECT_URI: 'https://dichvufb.tino.page/webhook/google-oauth-callback', 
            SCOPE: 'openid profile email' 
        };
        const URL_CREATE_ALBUM_SAVE = 'https://dichvufb.tino.page/webhook/create-album-auto'; 
        const URL_GET_FOLDER_INFO = 'https://dichvufb.tino.page/webhook/get-folder-info';
        const FALLBACK_NAME = 'Admin';


        // 🔥 HÀM MỚI: CHUYỂN HƯỚNG ĐẾN WEBHOOK CHECK STATUS
        function forceRefreshStatus(email) {
            const redirectUrl = window.location.href.split('?')[0];
            
            // Tham số action=check_status báo cho Workflow rằng đây là yêu cầu kiểm tra trạng thái chứ không phải đăng nhập
            const refreshApiUrl = `${GOOGLE_CONFIG.N8N_OAUTH_REDIRECT_URI}?action=check_status&email=${encodeURIComponent(email)}&redirect_to=${encodeURIComponent(redirectUrl)}`;

            // Tạm thời xóa trạng thái cục bộ
            localStorage.removeItem('admin_status');
            localStorage.removeItem('admin_expiry');

            window.location.href = refreshApiUrl;
        }


        function startGoogleLogin() {
            localStorage.setItem('current_admin_path', window.location.href.split('?')[0]);
            window.location.href = `https://accounts.google.com/o/oauth2/v2/auth?client_id=${GOOGLE_CONFIG.CLIENT_ID}&redirect_uri=${encodeURIComponent(GOOGLE_CONFIG.N8N_OAUTH_REDIRECT_URI)}&response_type=code&scope=${encodeURIComponent(GOOGLE_CONFIG.SCOPE)}&access_type=offline&prompt=consent`;
        }

        // ===============================================
        // 🔥 HÀM checkAuthCallback ĐÃ ĐƯỢC SỬA LỖI LƯU TRỮ LOCALSTORAGE
        // ===============================================
        function checkAuthCallback() {
            const urlParams = new URLSearchParams(window.location.search);
            
            const isCallback = urlParams.get('auth_status') === 'success';
            const isStatusRefresh = urlParams.get('status_checked') === 'true';

            if (isCallback || isStatusRefresh) {
                localStorage.setItem('admin_is_logged_in', 'true');
                localStorage.setItem('admin_email', urlParams.get('user_email'));
                
                try {
                    
                    // 1. Cập nhật TÊN
                    const userNameFromUrl = urlParams.get('user_name');
                    // Chỉ ghi đè nếu tham số tồn tại (tức là từ luồng OAuth)
                    if (userNameFromUrl !== null) { 
                        localStorage.setItem('admin_name', decodeURIComponent(userNameFromUrl));
                    }

                    // 2. Cập nhật AVATAR
                    const userAvatarFromUrl = urlParams.get('user_avatar');
                    // Chỉ ghi đè nếu tham số tồn tại (tức là từ luồng OAuth)
                    if (userAvatarFromUrl !== null) { 
                        localStorage.setItem('admin_avatar', decodeURIComponent(userAvatarFromUrl));
                    }
                    
                    // 3. Cập nhật Trạng thái và Thời gian HẾT HẠN MỚI NHẤT
                    // (Luôn ghi đè giá trị mới nhất từ n8n)
                    localStorage.setItem('admin_expiry', urlParams.get('user_expiry') || '0');
                    localStorage.setItem('admin_status', urlParams.get('user_status') || 'new');
                    
                } catch(e) {
                     console.error("Lỗi khi đọc tham số URL:", e);
                }
                
                history.replaceState(null, null, window.location.pathname);
                updateUI();
            }
        }
        // ===============================================


        function logoutAdmin() { localStorage.clear(); window.location.href = 'admin.html'; }

        function formatTimestamp(timestamp) {
            if (!timestamp || parseInt(timestamp) <= Date.now()) return 'Đã hết hạn';
            const date = new Date(parseInt(timestamp));
            return date.toLocaleString('vi-VN', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
        }


        function updateUI() {
            const isLoggedIn = localStorage.getItem('admin_is_logged_in') === 'true';
            const userEmail = localStorage.getItem('admin_email');
            let status = localStorage.getItem('admin_status');
            let expiry = parseInt(localStorage.getItem('admin_expiry')) || 0;
            const userName = localStorage.getItem('admin_name');

            if (isLoggedIn) {
                const currentTimestamp = Date.now();
                const isExpiredLocally = expiry > 0 && expiry <= currentTimestamp;

                // 🔥 LOGIC KIỂM TRA HẾT HẠN CỤC BỘ VÀ BUỘC LÀM MỚI 
                if (isExpiredLocally && status !== 'expired') {
                    // Cập nhật status thành 'expired' cục bộ để hiển thị thông báo chính xác
                    localStorage.setItem('admin_status', 'expired');
                    status = 'expired';
                    
                    // Sau đó, buộc làm mới trạng thái từ Backend
                    forceRefreshStatus(userEmail);
                    return; // Dừng UI để chờ làm mới
                }
                
                // Hiển thị UI sau khi đã kiểm tra (hoặc đang hoạt động)
                const adminNavLinks = document.getElementById('adminNavLinks');
                const loginBtn = document.getElementById('loginBtn');
                const userControl = document.getElementById('userControl');
                const userEmailDisplay = document.getElementById('userEmailDisplay');
                const statusAlert = document.getElementById('statusAlert');
                const btnCreate = document.getElementById('btnCreate');

                adminNavLinks.style.display = 'flex';
                loginBtn.style.display = 'none';
                userControl.style.display = 'flex';
                
                // Kiểm tra cho phép (status phải là 'active' VÀ chưa hết hạn)
                const isAllowed = (status === 'active' && !isExpiredLocally);
                let badgeHtml = '';

                // XỬ LÝ BADGE và ALERT
                if (isAllowed) {
                    statusAlert.style.display = 'none';
                    badgeHtml = `<span class="status-badge badge-active">Hạn: ${formatTimestamp(expiry)}</span>`;
                } else {
                    statusAlert.style.display = 'flex';
                    statusAlert.classList.remove('alert-locked');
                    statusAlert.classList.add('alert-locked');
                    
                    if (status === 'new' || expiry === 0) {
                        statusAlert.innerHTML = `<i class="fas fa-user-clock text-warning fa-lg"></i> <span>Tài khoản mới. Vui lòng <a href="payment.html">Gia Hạn</a> hoặc <a href="lienhe.html">Liên Hệ Admin</a>.</span>`;
                        badgeHtml = `<span class="status-badge badge-expired">MỚI</span>`;
                    } else if (status === 'expired' || isExpiredLocally) { 
                        statusAlert.innerHTML = `<i class="fas fa-lock text-danger fa-lg"></i> <span>Tài khoản hết hạn. Vui lòng <a href="payment.html">Gia Hạn</a>.</span>`;
                        badgeHtml = `<span class="status-badge badge-expired">HẾT HẠN</span>`;
                    } else {
                         statusAlert.innerHTML = `<i class="fas fa-lock text-danger fa-lg"></i> <span>Trạng thái không rõ.</span>`;
                         badgeHtml = `<span class="status-badge badge-expired">LỖI/KHÔNG RÕ</span>`;
                    }
                }

                // Cập nhật HEADER
                const avatar = localStorage.getItem('admin_avatar');
                let imgTag = avatar ? `<img src="${avatar}" class="user-avatar me-1">` : `<i class="fas fa-user-circle me-1"></i>`;
                userEmailDisplay.innerHTML = `${imgTag} ${userName || FALLBACK_NAME} ${badgeHtml}`;

                // Cập nhật BUTTON
                if (isAllowed) {
                    btnCreate.disabled = false; btnCreate.innerHTML = '<i class="fas fa-magic"></i> Tạo Album Ngay'; btnCreate.style.cursor = 'pointer';
                } else {
                    btnCreate.disabled = true; btnCreate.innerHTML = '<i class="fas fa-lock"></i> Tính năng bị khóa'; btnCreate.style.cursor = 'not-allowed';
                }

            } else {
                // CHƯA ĐĂNG NHẬP
                adminNavLinks.style.display = 'none'; loginBtn.style.display = 'flex'; userControl.style.display = 'none'; statusAlert.style.display = 'none'; btnCreate.disabled = true;
            }
        }

        // --- HÀM TẠO ALBUM & TIỆN ÍCH (GIỮ NGUYÊN) ---

        function extractFolderId(link) {
            if (!link) return null;
            let cleaned = link.split('?')[0].replace(/\/$/, ""); 
            const match = cleaned.match(/folders\/([-a-zA-Z0-9_]+)/);
            return match ? match[1] : (cleaned.match(/^[a-zA-Z0-9_-]+$/) ? cleaned : null);
        }

        function copyFinalLink() {
            const link = document.getElementById('previewClientLink');
            if (link.href && link.innerText !== '...') navigator.clipboard.writeText(link.href).then(() => showNotification('✅ Đã sao chép link!'));
        }

        function showNotification(msg) {
            const n = document.getElementById('copyNotification');
            n.innerHTML = `<i class="fas fa-check-circle me-2"></i>${msg}`; n.classList.add('active');
            setTimeout(() => n.classList.remove('active'), 3000);
        }

        async function createAlbum() {
            const driveLink = document.getElementById('driveLink').value.trim();
            const folderId = extractFolderId(driveLink);
            if (!folderId) return alert("Link không hợp lệ!");
            const btn = document.getElementById('btnCreate');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xử lý...'; btn.disabled = true;
            document.getElementById('previewBox').style.display = 'none';
            try {
                await fetch(URL_CREATE_ALBUM_SAVE, {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        folderId: folderId, adminEmail: localStorage.getItem('admin_email'),
                        settings: { download: document.getElementById('allowDownload').checked, comment: document.getElementById('allowComment').checked, limitPhotos: document.getElementById('limitPhotos').checked }
                    })
                });
                const res = await fetch(`${URL_GET_FOLDER_INFO}?folderId=${folderId}&adminEmail=${localStorage.getItem('admin_email')}`);
                if (!res.ok) throw new Error('Lỗi server');
                const data = await res.json();
                if (data.clientLink) {
                    document.getElementById('previewFolderName').innerText = data.folderName;
                    document.getElementById('previewClientLink').href = data.clientLink;
                    document.getElementById('previewClientLink').innerText = data.clientLink;
                    document.getElementById('previewBox').style.display = 'block';
                    showNotification('Tạo thành công!');
                }
            } catch (e) { alert("Lỗi: " + e.message); } finally { btn.innerHTML = '<i class="fas fa-magic"></i> Tạo Album Ngay'; btn.disabled = false; }
        }

        // =========================================
        // JAVASCRIPT CHAT WIDGET (GIỮ NGUYÊN)
        // =========================================
        const CHAT_WEBHOOK_URL = 'https://dichvufb.tino.page/webhook/chat-admin'; 

        let chatSessionId = localStorage.getItem('chat_session_id');
        if (!chatSessionId) {
            chatSessionId = 'admin-' + Math.random().toString(36).substring(7);
            localStorage.setItem('chat_session_id', chatSessionId);
        }

        function playSound() {
            const audio = new Audio("https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3");
            audio.volume = 0.3;
            audio.play().catch(e => {
                console.log("Autoplay blocked. User needs to click first.");
            });
        }

        function toggleChat() {
            const chatBox = document.getElementById('chat-box');
            const toggleBtn = document.getElementById('chat-toggle-btn');
            const bubble = document.getElementById('chat-greeting-bubble');
            
            if (bubble) bubble.classList.remove('show');

            if (chatBox.style.display === 'none' || !chatBox.style.display) {
                chatBox.style.display = 'flex';
                toggleBtn.classList.remove('pulse');
                setTimeout(() => document.getElementById('chat-input').focus(), 100);
            } else {
                chatBox.style.display = 'none';
            }
        }

        function handleEnter(e) { if (e.key === 'Enter') sendMessage(); }

        async function sendMessage() {
            const input = document.getElementById('chat-input');
            const message = input.value.trim();
            if (!message) return;
            addMessageToUI(message, 'user');
            input.value = '';
            const loadingId = 'loading-' + Date.now();
            showTypingIndicator(loadingId);
            try {
                const response = await fetch(CHAT_WEBHOOK_URL, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message, sessionId: chatSessionId })
                });
                const data = await response.json();
                document.getElementById(loadingId)?.remove();
                
                let finalData = data;
                if (Array.isArray(data) && data.length > 0) finalData = data[0]; 

                const aiReply = finalData.output || finalData.text || "Xin lỗi, hệ thống lỗi.";
                addMessageToUI(aiReply, 'bot');
                playSound();

            } catch (error) {
                document.getElementById(loadingId)?.remove();
                addMessageToUI("❌ Lỗi kết nối server AI.", 'bot');
            }
        }

        function addMessageToUI(text, sender) {
            const messagesContainer = document.getElementById('chat-messages');
            const msgDiv = document.createElement('div');
            msgDiv.className = `message ${sender === 'user' ? 'user-message' : 'bot-message'}`;
            msgDiv.innerHTML = text.replace(/\n/g, '<br>');
            messagesContainer.appendChild(msgDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function showTypingIndicator(id) {
            const messagesContainer = document.getElementById('chat-messages');
            const loadingDiv = document.createElement('div');
            loadingDiv.id = id; loadingDiv.className = 'typing-indicator';
            loadingDiv.innerHTML = '<i class="fas fa-circle-notch fa-spin me-2"></i>AI đang phản hồi...';
            messagesContainer.appendChild(loadingDiv); messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function showGreetingBubble() {
            const bubble = document.getElementById('chat-greeting-bubble');
            const messagesContainer = document.getElementById('chat-messages');
            
            messagesContainer.innerHTML = '';
            addMessageToUI("👋 Xin chào Admin! Em là Trợ lý ảo của Studio Lâm Nam Phước.\nEm có thể giúp gì cho anh/chị hôm nay ạ?", 'bot');

            setTimeout(() => {
                if (bubble) {
                    bubble.classList.add('show');
                    playSound();
                }
            }, 1500);
        }

        document.addEventListener('DOMContentLoaded', () => {
            checkAuthCallback();
            updateUI();
            
            document.body.addEventListener('click', function unlockAudio() {
                const dummyAudio = new Audio();
                dummyAudio.play().catch(()=>{});
                document.body.removeEventListener('click', unlockAudio);
            }, { once: true });

            showGreetingBubble();
        });
    </script>
