<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Quản Lý - Studio LNP</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root { --primary-green: #147a30; --dark-green: #0e5a22; --bg-color: #1a1a1a; --text-color: #f0f0f0; --accent-color: #51ff7d; }
        body { background-color: var(--bg-color); background-image: radial-gradient(#333 15%, transparent 16%), radial-gradient(#333 15%, transparent 16%); background-size: 60px 60px; background-position: 0 0, 30px 30px; color: var(--text-color); font-family: 'Nunito', sans-serif; min-height: 100vh; padding-top: 80px; }
        
        .navbar { background: var(--primary-green); box-shadow: 0 4px 20px rgba(0,0,0,0.3); backdrop-filter: blur(10px); }
        .navbar-brand { font-weight: 800; font-size: 1.5rem; color: white !important; text-transform: uppercase; letter-spacing: 1px; }
        .nav-link { color: rgba(255,255,255,0.9) !important; font-weight: 600; transition: all 0.3s; border-radius: 8px; }

        /* ⭐ ĐỒNG BỘ USER INFO THEO ẢNH MẪU */
        .user-status-box { background-color: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 50px; padding: 5px 15px; display: flex; align-items: center; gap: 10px; font-size: 0.9rem; }
        .user-avatar-circle { width: 32px; height: 32px; background: #333; color: var(--accent-color); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; border: 2px solid var(--accent-color); text-transform: uppercase; overflow: hidden; }
        .user-avatar-circle img { width: 100%; height: 100%; object-fit: cover; }
        .status-badge { padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; color: white; }
        .bg-active { background-color: #198754; } .bg-new { background-color: #ff9800; color: white; } .bg-expired { background-color: #dc3545; }

        .dashboard-container { max-width: 1400px; margin: 0 auto; padding: 30px 20px; }
        h2 { color: var(--accent-color); text-align: center; margin-bottom: 30px; font-weight: 800; text-shadow: 0 0 20px rgba(81, 255, 125, 0.5); font-size: 2.2rem; }
        .search-wrapper { max-width: 500px; margin: 0 auto 40px auto; position: relative; }
        .search-input { width: 100%; padding: 12px 20px 12px 45px; border-radius: 50px; border: 2px solid rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.05); color: white; font-weight: 600; outline: none; transition: 0.3s; }
        .search-icon { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: rgba(255, 255, 255, 0.5); }

        #albumGrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 35px; }
        .album-card { background: rgba(255, 255, 255, 0.98); color: #333; border-radius: 20px; overflow: hidden; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2); transition: 0.3s; display: flex; flex-direction: column; }
        .album-card-header { height: 200px; background-size: cover; background-position: center; position: relative; }
        .album-title-overlay { position: absolute; bottom: 0; left: 0; width: 100%; padding: 15px; background: linear-gradient(to top, rgba(0,0,0,0.8), transparent); color: white; font-weight: 800; font-size: 1.1rem; }
        .card-body-custom { padding: 20px; flex-grow: 1; }
        
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; }
        .stats-item { display: flex; align-items: center; gap: 8px; color: #555; font-weight: 700; font-size: 0.9rem; padding: 5px 10px; background: #f8f9fa; border-radius: 10px; cursor: default; }
        /* ⭐ CẢI TIẾN: CLICK VÀO STATS ĐỂ XEM NHANH */
        .stats-item.clickable:hover { background: #e9ecef; color: var(--primary-green); cursor: pointer; }

        .action-btns { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-top: 10px; }
        .action-btns button { padding: 8px 5px; border: none; border-radius: 12px; font-weight: 800; font-size: 0.75rem; color: white; text-transform: uppercase; transition: 0.2s; display: flex; flex-direction: column; align-items: center; gap: 4px; }
        .btn-view { background: #007bff; } .btn-export { background: #ffc107; color: #212529 !important; } .btn-delete { background: #dc3545; }
        .btn-drive { background: #4285F4; } .btn-note { background: #6f42c1; }

        #toastNotice { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: rgba(0, 0, 0, 0.9); color: white; padding: 12px 25px; border-radius: 50px; z-index: 9999; display: none; font-weight: 700; border: 1px solid var(--accent-color); }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg fixed-top navbar-dark">
        <div class="container-fluid px-4">
            <a class="navbar-brand" href="#">Dashboard</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a href="admin.html" class="nav-link">Tạo Album</a></li>
                    <li class="nav-item"><a href="copy_local.html" class="nav-link">Sao Chép</a></li>
                    <li class="nav-item"><a href="managa.html" class="nav-link active">Quản Lý</a></li>
                </ul>
                <div id="authControl" style="display: none;" class="align-items-center gap-3">
                    <div class="user-status-box">
                        <div class="user-avatar-circle" id="userAvatarPlaceholder"></div>
                        <div>
                            <div class="fw-bold text-white" id="userNameDisplay">...</div>
                            <div style="font-size: 0.7rem; color: #ddd; margin-top: -2px;">
                                <span id="badgeStatus" class="status-badge">...</span>
                                <span class="ms-1" id="userExpiryText"></span>
                            </div>
                        </div>
                    </div>
                    <button onclick="logoutAdmin()" class="btn btn-danger rounded-pill px-3 py-1"><i class="fas fa-sign-out-alt"></i></button>
                </div>
            </div>
        </div>
    </nav>

    <div class="dashboard-container">
        <h2>Danh Sách Album (<span id="albumCount">0</span>)</h2>
        <div class="search-wrapper">
            <i class="fas fa-search search-icon"></i>
            <input type="text" id="albumSearch" class="search-input" placeholder="Tìm kiếm tên album..." oninput="filterAlbums()">
        </div>
        <div id="albumGrid"></div>
    </div>

    <div id="toastNotice"></div>

    <div class="modal fade" id="exportModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header text-white bg-success">
                    <h5 class="modal-title"><i class="fas fa-file-export me-2"></i> KẾT QUẢ XUẤT FILE</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body bg-light">
                    <p class="text-secondary fw-bold">Sao chép danh sách bên dưới để lọc ảnh:</p>
                    <div class="alert alert-info py-2" id="modalInfo"></div>
                    <textarea id="fileNamesOutput" class="form-control shadow-sm" rows="10" readonly style="font-family: monospace;"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary fw-bold px-4" onclick="copyFileNames()"><i class="fas fa-copy me-2"></i>Sao Chép</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const URL_GET_ALBUM_LIST = 'https://dichvufb.tino.page/webhook/get-album-list';
        const URL_DELETE_ALBUM = 'https://dichvufb.tino.page/webhook/delete-album'; 
        const URL_EXPORT_FILENAMES = 'https://dichvufb.tino.page/webhook/export_filenames'; 
        const DOMAIN_CLIENT = 'https://phuoclam095-bot.github.io/chonanhtudong/'; 

        let adminEmail = localStorage.getItem('admin_email'), allAlbums = [];

        function showToast(msg) {
            const t = document.getElementById('toastNotice');
            t.innerText = msg; t.style.display = 'block';
            setTimeout(() => t.style.display = 'none', 3000);
        }

        function filterAlbums() {
            const kw = document.getElementById('albumSearch').value.toLowerCase();
            renderAlbums(allAlbums.filter(a => (a.folderName || a.name || '').toLowerCase().includes(kw)));
        }

        function renderAlbums(albums) {
            const grid = document.getElementById('albumGrid');
            grid.innerHTML = albums.length ? '' : '<div class="text-center w-100 py-5">Không tìm thấy album.</div>';
            albums.forEach(a => grid.appendChild(createAlbumCard(a)));
            document.getElementById('albumCount').innerText = albums.length;
        }

        function createAlbumCard(album) {
            const card = document.createElement('div');
            const id = album.folder_id || album.folderId;
            card.id = `card-${id}`; card.className = 'album-card';
            const rawName = album.folderName || album.name || 'Album';
            const img = album.thumbnailFileId ? `https://drive.google.com/thumbnail?id=${album.thumbnailFileId}&sz=w600` : 'https://images.unsplash.com/photo-1542838132-e0c19b48b940?auto=format&fit=crop&w=600&q=80';
            
            // ⭐ TỔ CHỨC LẠI NÚT BẤM VÀ THÔNG SỐ
            card.innerHTML = `
                <div class="album-card-header" style="background-image: url('${img}');">
                    <div class="album-title-overlay">${rawName}</div>
                </div>
                <div class="card-body-custom">
                    <div class="stats-grid">
                        <div class="stats-item clickable" title="Xem ảnh đã chọn" onclick="window.open('${DOMAIN_CLIENT}client.html?id=${id}&mode=selected', '_blank')">
                            <i class="fas fa-check-circle text-success"></i> Chọn: ${album.selected_photos || 0}
                        </div>
                        <div class="stats-item"><i class="fas fa-images text-primary"></i> Tổng: ${album.total_photos || 0}</div>
                        <div class="stats-item clickable" style="grid-column: span 2;" onclick="window.open('${DOMAIN_CLIENT}client.html?id=${id}&mode=notes', '_blank')">
                            <i class="fas fa-comment-dots text-info"></i> Ghi chú: ${album.comments || 0}
                        </div>
                    </div>
                    <div class="action-btns">
                        <button class="btn-view" onclick="window.open('${DOMAIN_CLIENT}client.html?id=${id}', '_blank')"><i class="fas fa-eye"></i> Xem</button>
                        <button class="btn-drive" onclick="window.open('https://drive.google.com/drive/folders/${id}', '_blank')"><i class="fab fa-google-drive"></i> Gốc</button>
                        <button class="btn-export" onclick="handleExportClick('${id}', '${rawName.replace(/'/g, "\\'")}')"><i class="fas fa-file-export"></i> Xuất</button> 
                        <button class="btn-delete" style="grid-column: span 3;" onclick="deleteAlbum('${id}', '${rawName.replace(/'/g, "\\'")}')"><i class="fas fa-trash-alt me-1"></i> Xóa Album</button>
                    </div>
                </div>`;
            return card;
        }

        async function handleExportClick(albumId, albumName) {
            showToast(`Đang xử lý album: ${albumName}...`);
            try {
                const res = await fetch(URL_EXPORT_FILENAMES, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ folderId: albumId, adminEmail: adminEmail, action: 'export_filenames_request' })
                });
                const result = await res.json();
                const data = Array.isArray(result) ? result[0] : result;
                if (data && data.fileNamesForCopy) {
                    document.getElementById('modalInfo').innerHTML = `Album: <strong>${albumName}</strong> | <strong>${data.selectedPhotos || 0} ảnh</strong>`;
                    document.getElementById('fileNamesOutput').value = data.fileNamesForCopy.split(',').map(n => n.trim()).join('\n');
                    new bootstrap.Modal(document.getElementById('exportModal')).show();
                    showToast("Xuất danh sách thành công!");
                } else { showToast("Album này chưa có ảnh nào được chọn!"); }
            } catch (e) { showToast("Lỗi hệ thống!"); }
        }

        function copyFileNames() {
            const txt = document.getElementById('fileNamesOutput').value;
            navigator.clipboard.writeText(txt.split('\n').join(',')).then(() => {
                showToast("✅ Đã sao chép danh sách file!");
            });
        }

        async function deleteAlbum(id, name) {
            if (!confirm(`Bạn có chắc chắn muốn xóa vĩnh viễn album "${name}"?`)) return;
            try {
                const res = await fetch(URL_DELETE_ALBUM, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ folderId: id, adminEmail: adminEmail }) });
                const r = await res.json();
                if (r.success) { document.getElementById(`card-${id}`).remove(); showToast("Đã xóa album."); }
            } catch (e) { showToast("Lỗi xóa!"); }
        }

        function updateHeaderUI() {
            const auth = document.getElementById('authControl');
            if (localStorage.getItem('admin_is_logged_in') === 'true') {
                const name = localStorage.getItem('admin_name');
                const avatar = localStorage.getItem('admin_avatar');
                const status = localStorage.getItem('admin_status') || 'new';
                const expiry = parseInt(localStorage.getItem('admin_expiry')) || 0;
                const now = Date.now();

                document.getElementById('userNameDisplay').innerText = name;
                document.getElementById('userAvatarPlaceholder').innerHTML = (avatar && avatar !== 'null') ? `<img src="${avatar}">` : name.charAt(0).toUpperCase();
                
                const badge = document.getElementById('badgeStatus');
                const expiryText = document.getElementById('userExpiryText');

                if (status === 'active' && expiry > now) {
                    badge.innerText = "ACTIVE"; badge.className = "status-badge bg-active";
                    expiryText.innerText = `(Hạn: ${new Date(expiry).toLocaleDateString('vi-VN')})`;
                } else if (status === 'new') {
                    badge.innerText = "TÀI KHOẢN MỚI"; badge.className = "status-badge bg-new";
                    expiryText.innerText = "";
                } else {
                    badge.innerText = "HẾT HẠN"; badge.className = "status-badge bg-expired";
                    expiryText.innerText = "(Gia hạn ngay)";
                }
                auth.style.display = 'flex';
            } else { window.location.href = 'admin.html'; }
        }

        async function init() {
            updateHeaderUI();
            const res = await fetch(`${URL_GET_ALBUM_LIST}?adminEmail=${adminEmail}`);
            allAlbums = await res.json();
            renderAlbums(allAlbums);
        }
        function logoutAdmin() { localStorage.clear(); window.location.href = 'admin.html'; }
        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
