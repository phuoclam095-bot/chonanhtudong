<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thanh Toán Gia Hạn - Dịch Vụ Của Bạn</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800&display=swap" rel="stylesheet">
    
    <style>
        /* ========================================= */
        /* CSS GIAO DIỆN CHUNG & NỀN */
        /* ========================================= */
        :root { 
            --primary-green: #147a30; 
            --dark-green: #0e5a22; 
            --bg-color: #1a1a1a; 
            --card-bg: #ffffff;
            --light-bg: #f8f9fa;
        }
        body { 
            font-family: 'Nunito', sans-serif; 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            justify-content: flex-start; 
            padding: 20px;
            background-color: var(--bg-color);
            /* Nền họa tiết chấp bi */
            background-image: radial-gradient(#333 15%, transparent 16%), radial-gradient(#333 15%, transparent 16%); 
            background-size: 60px 60px; 
            background-position: 0 0, 30px 30px; 
        }
        .payment-container { 
            background: var(--card-bg); 
            border-radius: 20px; 
            box-shadow: 0 20px 60px rgba(0,0,0,0.5); 
            padding: 40px; 
            max-width: 800px; 
            width: 100%; 
        }
        h2 { color: var(--dark-green); font-weight: 800; margin-bottom: 30px; text-align: center; }
        .price-unit { font-size: 2.2rem; font-weight: 800; color: var(--primary-green); margin-top: 5px; }
        
        /* Chọn gói */
        .package-select { 
            display: flex; 
            flex-wrap: wrap; 
            gap: 20px; 
            margin-bottom: 30px; 
        }
        .package-option-wrapper { 
            width: calc(50% - 10px); 
            box-sizing: border-box; 
        }
        .package-option { 
            padding: 25px; 
            border: 1px solid #ddd; 
            border-radius: 15px; 
            cursor: pointer; 
            transition: all 0.3s; 
            background: var(--light-bg); 
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .package-option.selected { 
            border-color: var(--primary-green); 
            background-color: #e6f7eb; 
            box-shadow: 0 5px 15px rgba(20, 122, 48, 0.2); 
            transform: scale(1.02); 
        }
        .package-option h5 { font-weight: 800; color: var(--dark-green); }
        .package-option small { color: var(--primary-green); font-weight: 700; } 

        /* QR AREA */
        #paymentArea { background: #f0fff4; border: 2px solid var(--primary-green); border-radius: 15px; padding: 30px; text-align: center; display: none; }
        #qrCodeImg { width: 100%; max-width: 280px; height: auto; border: 4px solid #fff; border-radius: 12px; margin: 15px 0; box-shadow: 0 5px 20px rgba(0,0,0,0.1); }
        .info-detail { background: #fff; padding: 20px; border-radius: 15px; border: 1px solid var(--primary-green); margin-top: 15px; }
        .info-detail strong { color: #d9534f; font-size: 1.3rem; }
        .info-detail p { font-weight: 600; color: #555; }
        
        /* Thông báo Copy */
        #copyNotification {
            position: fixed; bottom: 20px; right: 20px; 
            background: var(--primary-green); color: white; 
            padding: 10px 20px; border-radius: 10px; 
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            opacity: 0; transform: translateY(100px); 
            transition: all 0.5s ease;
        }
        #copyNotification.active {
            opacity: 1; transform: translateY(0);
        }

        @media (max-width: 768px) {
            .package-option-wrapper { width: 100%; }
        }
    </style>
</head>
<body>

<div class="payment-container">
    
    <h2 class="mb-4"><i class="fas fa-credit-card me-2"></i>Chọn Gói Gia Hạn Tài Khoản</h2>
    
    <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
        <i class="fas fa-user-circle fa-lg"></i>
        <span>Đang gia hạn cho tài khoản: <strong id="userEmailDisplay">Vui lòng đăng nhập</strong></span>
    </div>

    <div id="packageSelection" class="package-select">
        </div>
    
    <div class="text-center mt-4">
        <button id="btnContinue" class="btn btn-lg btn-success fw-bold" disabled onclick="processPayment()">
            <i class="fas fa-arrow-right"></i> Tiếp Tục Thanh Toán
        </button>
    </div>

    <div id="paymentArea" class="mt-5">
        <h3 class="text-danger fw-bold"><i class="fas fa-qrcode me-2"></i>Quét Mã VietQR để Thanh Toán</h3>
        <p class="text-muted">Vui lòng chuyển khoản chính xác **Số tiền** và **Nội dung chuyển khoản** dưới đây.</p>

        <img id="qrCodeImg" src="https://via.placeholder.com/280?text=QRCode+Chua+Tao" alt="Mã QR VietQR">
        
        <div class="row g-3 info-detail text-start">
            <div class="col-md-4">
                <p class="mb-0">Số Tiền Cần Chuyển:</p>
                <strong id="displayAmount" class="text-danger">0 VNĐ</strong>
            </div>
            <div class="col-md-8">
                <p class="mb-0">Nội Dung Chuyển Khoản (BẮT BUỘC):</p>
                <strong id="displayPaymentCode" class="text-primary" style="cursor: pointer;">MÃ_GIAO_DỊCH</strong>
                <small class="text-muted">Nhấn vào mã để sao chép.</small>
            </div>
        </div>
        
        <div class="alert alert-success mt-4">
            <i class="fas fa-check-circle me-2"></i>Hệ thống sẽ **TỰ ĐỘNG KÍCH HOẠT** tài khoản của bạn sau khi nhận được chuyển khoản (Thường 1-5 phút).
        </div>
    </div>
</div>

<div id="copyNotification"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // ===============================================
    //                  CẤU HÌNH VÀ DỮ LIỆU
    // ===============================================

    // ⚠️ CẤU HÌNH CỦA BẠN - Vui lòng cập nhật các giá trị này
    const PAYMENT_CONFIG = {
        BANK_ID: '970407', // Ví dụ: Vietcombank. Thay bằng mã ngân hàng của bạn
        ACCOUNT_NUMBER: '0123456789', // Số tài khoản nhận tiền của bạn
        N8N_SAVE_PAYMENT: 'https://dichvufb.tino.page/webhook/save-payment-pending' // Webhook để lưu trạng thái
    };

    // 🔥 GÓI GIA HẠN VỚI GIÁ CỐ ĐỊNH
    const PAYMENT_PACKAGES = [
        { months: 1, name: "Gói Cơ Bản", price: 90000, note: "Giá cố định" }, 
        { months: 3, name: "Gói Quý", price: 250000, note: "Tiết kiệm 20.000 VNĐ" }, 
        { months: 6, name: "Gói Nửa Năm", price: 450000, note: "Tiết kiệm 90.000 VNĐ" }, 
        { months: 12, name: "Gói Năm", price: 750000, note: "Tiết kiệm 330.000 VNĐ" }
    ];

    let selectedPackage = null;
    let finalAmount = 0;
    let paymentCode = '';
    
    // GIẢ LẬP: Lấy Email từ local storage hoặc API đăng nhập (Bạn cần thay thế bằng logic thực tế)
    // Giả định người dùng đã đăng nhập với email này.
    let userEmail = localStorage.getItem('admin_email') || 'exampleuser@service.com'; 

    // ===============================================
    //                  HÀM TIỆN ÍCH
    // ===============================================

    function showNotification(msg) {
        const n = document.getElementById('copyNotification');
        n.innerHTML = `<i class="fas fa-check-circle me-2"></i>${msg}`; 
        n.classList.add('active');
        setTimeout(() => n.classList.remove('active'), 3000);
    }
    
    function formatCurrency(amount) {
        return amount.toLocaleString('vi-VN') + ' VNĐ';
    }

    function getCleanUserName(email) {
        return email.split('@')[0];
    }

    // ===============================================
    //                  LOGIC GIAO DỊCH
    // ===============================================

    /**
     * Tạo mã thanh toán duy nhất (Nội dung chuyển khoản)
     * @param {string} email - Email người dùng
     * @returns {string} Mã thanh toán
     */
    function generatePaymentCode(email) {
        const safeEmailPart = email.split('@')[0].toUpperCase().replace(/[^A-Z0-9]/g, '');
        const randomPart = Math.random().toString(36).substring(2, 8).toUpperCase();
        const uniquePart = `LNP_${safeEmailPart}_${randomPart}`.substring(0, 15);
        return `SEVQR_${uniquePart}`; 
    }

    /**
     * Render các gói gia hạn ra giao diện
     */
    function renderPackages() {
        const container = document.getElementById('packageSelection');
        container.innerHTML = '';

        PAYMENT_PACKAGES.forEach(pkg => {
            const actualPrice = pkg.price;
            const priceDisplay = formatCurrency(actualPrice);
            
            const wrapper = document.createElement('div');
            wrapper.className = 'package-option-wrapper col-12 col-md-6';

            const element = document.createElement('div');
            element.className = 'package-option'; 
            element.setAttribute('data-months', pkg.months);
            element.innerHTML = `
                <div>
                    <h5>${pkg.name} (${pkg.months} tháng)</h5>
                    <small style="color: var(--primary-green);">${pkg.note}</small>
                </div>
                <p class="price-unit">${priceDisplay}</p>
            `;
            
            element.addEventListener('click', () => selectPackage(element, pkg, actualPrice));
            wrapper.appendChild(element);
            container.appendChild(wrapper);
        });
    }

    /**
     * Xử lý khi người dùng chọn một gói
     */
    function selectPackage(element, pkg, price) {
        document.querySelectorAll('.package-option').forEach(el => el.classList.remove('selected'));
        
        element.classList.add('selected');
        selectedPackage = pkg;
        finalAmount = price;
        document.getElementById('btnContinue').disabled = false;
    }
    
    /**
     * Xử lý bước tạo giao dịch và hiển thị QR Code
     */
    async function processPayment() {
        if (!selectedPackage) return alert("Vui lòng chọn gói gia hạn!");
        
        paymentCode = generatePaymentCode(userEmail);
        
        const btn = document.getElementById('btnContinue');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang khởi tạo...';
        btn.disabled = true;

        try {
            // 1. Gọi Webhook n8n (hoặc API của bạn) để lưu trạng thái Pending
            // Bỏ qua bước này nếu bạn không dùng hệ thống tự động
            const response = await fetch(PAYMENT_CONFIG.N8N_SAVE_PAYMENT, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    email: userEmail,
                    paymentCode: paymentCode,
                    amount: finalAmount,
                    months: selectedPackage.months,
                    status: 'PENDING',
                    timestamp: Date.now()
                })
            });

            if (!response.ok) throw new Error("Lỗi server khi khởi tạo giao dịch.");
            
            // 2. Tạo URL VietQR
            const encodedPaymentCode = encodeURIComponent(paymentCode); 
            const vietQRUrl = `https://api.vietqr.io/image/${PAYMENT_CONFIG.BANK_ID}/${PAYMENT_CONFIG.ACCOUNT_NUMBER}/${finalAmount}/${encodedPaymentCode}/`;
            
            // 3. Hiển thị thông tin QR ra giao diện
            document.getElementById('qrCodeImg').src = vietQRUrl;
            document.getElementById('displayAmount').innerText = formatCurrency(finalAmount);
            document.getElementById('displayPaymentCode').innerText = paymentCode; 
            
            document.getElementById('paymentArea').style.display = 'block';
            document.getElementById('packageSelection').style.display = 'none';
            document.getElementById('btnContinue').style.display = 'none';
            
            // Cuộn đến khu vực thanh toán
            document.getElementById('paymentArea').scrollIntoView({ behavior: 'smooth' });
            
        } catch (e) {
            alert("Lỗi khởi tạo thanh toán: " + e.message + ". Vui lòng thử lại sau.");
            btn.innerHTML = '<i class="fas fa-arrow-right"></i> Tiếp Tục Thanh Toán';
            btn.disabled = false;
        }
    }
    
    // ===============================================
    //                  KHỞI TẠO
    // ===============================================

    function init() {
        if (!userEmail || userEmail === 'Vui lòng đăng nhập') {
            document.getElementById('userEmailDisplay').innerText = 'Chưa xác định';
            alert('Vui lòng đảm bảo người dùng đã đăng nhập (cần userEmail hợp lệ).');
        } else {
            document.getElementById('userEmailDisplay').innerText = userEmail;
        }

        renderPackages();
        
        // Thiết lập sự kiện sao chép nội dung chuyển khoản
        document.getElementById('displayPaymentCode').addEventListener('click', () => {
            navigator.clipboard.writeText(document.getElementById('displayPaymentCode').innerText).then(() => {
                showNotification(`✅ Đã sao chép nội dung chuyển khoản!`);
            });
        });
    }

    document.addEventListener('DOMContentLoaded', init);
</script>
</body>
</html>
