    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // *************************************************************
        // ✅ CẤU HÌNH WEBHOOKS
        // *************************************************************
        const GOOGLE_CONFIG = {
            CLIENT_ID: '781143890416-3hsl3fii3is9r7fl6m55gsuuulcteiq8.apps.googleusercontent.com', 
            N8N_OAUTH_REDIRECT_URI: 'https://dichvufb.tino.page/webhook/google-oauth-callback', 
            SCOPE: 'openid profile email' 
        };
        // URL WEBHOOK 1: LƯU SHEET (POST)
        const URL_CREATE_ALBUM_SAVE = 'https://dichvufb.tino.page/webhook/create-album-auto'; 
        // URL WEBHOOK 2: LẤY TÊN VÀ LINK ALBUM (GET)
        const URL_GET_FOLDER_INFO = 'https://dichvufb.tino.page/webhook/get-folder-info';

        // *************************************************************
        // 💡 HÀM HỖ TRỢ VÀ LOGIC ĐĂNG NHẬP
        // *************************************************************
        
        function startGoogleLogin() {
            localStorage.setItem('current_admin_path', window.location.href.split('?')[0]);
            
            const authUrl = 'https://accounts.google.com/o/oauth2/v2/auth?' + 
                'client_id=' + GOOGLE_CONFIG.CLIENT_ID + 
                '&redirect_uri=' + encodeURIComponent(GOOGLE_CONFIG.N8N_OAUTH_REDIRECT_URI) + 
                '&response_type=code' + 
                '&scope=' + encodeURIComponent(GOOGLE_CONFIG.SCOPE) + 
                '&access_type=offline' +
                '&prompt=consent'; 

            window.location.href = authUrl;
        }

        function logoutAdmin() {
            localStorage.removeItem('admin_is_logged_in');
            localStorage.removeItem('admin_email');
            localStorage.removeItem('admin_name');
            localStorage.removeItem('google_access_token'); 
            updateUI(); 
        }

        function updateUI(email = null, expiration = '90 ngày') {
            const adminNavLinks = document.getElementById('adminNavLinks');
            const loginBtn = document.getElementById('loginBtn');
            const userControl = document.getElementById('userControl');
            const userEmailDisplay = document.getElementById('userEmailDisplay');
            
            const isLoggedIn = localStorage.getItem('admin_is_logged_in') === 'true';
            const storedName = localStorage.getItem('admin_name');
            const storedEmail = localStorage.getItem('admin_email');

            if (isLoggedIn) {
                // Hiển thị menu admin
                if (adminNavLinks) {
                    adminNavLinks.style.display = 'flex';
                    adminNavLinks.classList.remove('d-none'); // Bootstrap class
                }
                
                // Ẩn nút đăng nhập, hiện user control
                if (loginBtn) loginBtn.style.display = 'none';
                if (userControl) {
                    userControl.style.display = 'flex';
                    userControl.classList.remove('d-none');
                }
                
                userEmailDisplay.innerHTML = `<i class="fas fa-user-circle me-2"></i>${storedName || storedEmail || 'Admin'}`;
                
            } else {
                // Ẩn menu admin
                if (adminNavLinks) adminNavLinks.style.display = 'none';
                
                // Hiện nút đăng nhập, ẩn user control
                if (loginBtn) loginBtn.style.display = 'flex';
                if (userControl) userControl.style.display = 'none';
            }
        }

        function checkAuthCallback() {
            const urlParams = new URLSearchParams(window.location.search);
            const authStatus = urlParams.get('auth_status'); 
            const userEmail = urlParams.get('user_email');
            const userName = urlParams.get('user_name'); 
            const accessToken = urlParams.get('access_token'); 

            if (authStatus === 'success' && userEmail) {
                history.replaceState(null, null, window.location.pathname); 

                localStorage.setItem('admin_is_logged_in', 'true');
                localStorage.setItem('admin_email', userEmail);
                
                if (accessToken) {
                    localStorage.setItem('google_access_token', accessToken); 
                }

                if (userName) {
                    localStorage.setItem('admin_name', userName);
                } else {
                    localStorage.setItem('admin_name', userEmail.split('@')[0]);
                }
            }
        }

        // Hàm trích xuất Folder ID từ link
        function extractFolderId(link) {
            if (!link) return null;
            let cleanedLink = link.split('?')[0].replace(/\/$/, ""); 
            
            const match = cleanedLink.match(/folders\/([-a-zA-Z0-9_]+)/);
            
            if (match) {
                return match[1]; 
            }
            
            if (cleanedLink.match(/^[a-zA-Z0-9_-]+$/)) {
                return cleanedLink;
            }

            return null; 
        }

        function copyFinalLink() {
            const linkElement = document.getElementById('previewClientLink');
            
            if (linkElement && linkElement.href && linkElement.innerText !== '...') {
                navigator.clipboard.writeText(linkElement.href).then(() => {
                    showNotification('✅ Đã sao chép link!');
                }).catch(err => {
                    console.error('Không thể sao chép:', err);
                    alert('❌ Lỗi: Không thể sao chép link.');
                });
            } else {
                 alert('❌ Lỗi: Link chưa được tạo thành công.');
            }
        }

        // ✅ HÀM HIỂN THỊ THÔNG BÁO CHUNG
        function showNotification(message) {
            const notification = document.getElementById('copyNotification');
            if (notification) {
                notification.innerHTML = `<i class="fas fa-check-circle me-2"></i>${message}`; 
                notification.classList.add('active');
                setTimeout(() => {
                    notification.classList.remove('active');
                }, 3000); 
            }
        }

        // *************************************************************
        // 💡 LOGIC TẠO ALBUM
        // *************************************************************
        
        async function createAlbum() {
            // Kiểm tra đăng nhập trước
            if (localStorage.getItem('admin_is_logged_in') !== 'true') {
                alert("Vui lòng đăng nhập bằng Google trước khi tạo Album!");
                startGoogleLogin();
                return;
            }

            const btn = document.querySelector('.btn-create');
            const driveLinkInput = document.getElementById('driveLink');
            const previewBox = document.getElementById('previewBox');
            const previewFolderName = document.getElementById('previewFolderName');
            const previewClientLink = document.getElementById('previewClientLink');
            
            previewBox.style.display = 'none'; // Ẩn trạng thái cũ

            let inputLink = driveLinkInput.value.trim(); 
            const folderId = extractFolderId(inputLink); // Lấy ID

            // 1. KIỂM TRA TÍNH HỢP LỆ (LỖI CHẶN)
            if (!folderId) {
                alert("Vui lòng dán link Google Drive hợp lệ (ID thư mục)!");
                return;
            }

            // 2. HIỂN THỊ TRẠNG THÁI ĐANG XỬ LÝ
            const oldText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang khởi tạo...'; 
            btn.disabled = true;

            try {
                // CHUẨN BỊ DỮ LIỆU JSON BODY CHUNG
                const dataToSend = {
                    folderId: folderId, 
                    settings: {
                        download: document.getElementById('allowDownload').checked,
                        comment: document.getElementById('allowComment').checked,
                        limitPhotos: document.getElementById('limitPhotos').checked,
                    },
                    adminEmail: localStorage.getItem('admin_email')
                };

                // -----------------------------------------------------------------
                // ✅ BƯỚC 1: GỌI WEBHOOK LƯU SHEET (create-album-auto) - POST METHOD
                // -----------------------------------------------------------------
                
                const responseSave = await fetch(URL_CREATE_ALBUM_SAVE, {
                    method: 'POST', 
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json' 
                    },
                    body: JSON.stringify(dataToSend) // GỬI DỮ LIỆU TRONG BODY
                });

                if (!responseSave.ok) {
                    throw new Error(`Lỗi HTTP (${responseSave.status}) khi Lưu Dữ Liệu vào Sheet.`);
                }
                
                // Cập nhật trạng thái
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang lấy thông tin...'; 


                // -----------------------------------------------------------------
                // ✅ BƯỚC 2: GỌI WEBHOOK LẤY TÊN VÀ LINK (get-folder-info) - GET METHOD
                // -----------------------------------------------------------------

                // Chuẩn bị Query Parameters cho Webhook GET INFO
                const infoParams = new URLSearchParams({ 
                    folderId: folderId, 
                    adminEmail: localStorage.getItem('admin_email') 
                }).toString();
                const infoUrl = `${URL_GET_FOLDER_INFO}?${infoParams}`;

                const responseInfo = await fetch(infoUrl, {
                    method: 'GET', // Giả định là GET cho truy vấn
                    headers: { 'Accept': 'application/json' }
                });

                if (!responseInfo.ok) {
                    throw new Error(`Lỗi HTTP (${responseInfo.status}) khi Lấy Thông Tin Album.`);
                }
                
                const result = await responseInfo.json(); 
                
                // -----------------------------------------------------------------
                // ✅ BƯỚC 3: HIỂN THỊ KẾT QUẢ
                // -----------------------------------------------------------------

                if (result && result.folderName && result.clientLink) {
                    
                    const clientLink = result.clientLink;

                    // Cập nhật preview box (Goal 2: Chỉ hiển thị tên Album)
                    previewFolderName.innerText = result.folderName;
                    previewFolderName.className = "text-success fs-5"; // Reset class nếu trước đó bị lỗi
                    
                    previewClientLink.href = clientLink;
                    previewClientLink.innerText = clientLink;
                    
                    previewBox.style.display = 'block';
                    previewBox.style.backgroundColor = '#f0fff4'; // Reset màu nền
                    previewBox.style.borderColor = '#c3e6cb';

                    // HIỂN THỊ THÔNG BÁO TẠO LINK THÀNH CÔNG TRÊN MÀN HÌNH
                    showNotification(`✅ Đã tạo Link Album thành công!`); 
                    
                } else {
                    // LỖI: Dữ liệu JSON trả về bị thiếu trường folderName hoặc clientLink
                    throw new Error('Dữ liệu trả về từ Webhook Get Info bị thiếu (folderName/clientLink).');
                }

            } catch (error) {
                // XỬ LÝ LỖI CHUNG
                console.error(error);
                previewBox.style.borderColor = '#f5c6cb';
                previewBox.style.backgroundColor = '#f8d7da'; 
                previewFolderName.style.color = '#721c24';

                // HIỂN THỊ LỖI CHÍNH XÁC THEO YÊU CẦU MỚI
                previewFolderName.innerText = `❌ Lỗi Kiểm Tra Link!`;
                previewClientLink.innerText = 'Vui lòng đảm bảo link Google Drive đã được công khai (Anyone with the link).';
                previewClientLink.href = "#";
                previewBox.style.display = 'block';
            } finally {
                // KHÔI PHỤC NÚT
                btn.innerHTML = '<i class="fas fa-magic"></i> Tạo Album Ngay';
                btn.disabled = false;
            }
        }
        
        // 7. Khởi tạo trang: 
        document.addEventListener('DOMContentLoaded', function() {
            checkAuthCallback();
            updateUI();
        });
        
    </script>
</body>
</html>
