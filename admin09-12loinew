    <style>
        /* CSS (Đã đồng bộ) */
        :root { 
            --primary-green: #147a30; 
            --dark-green: #0e5a22; 
            --bg-color: #1a1a1a;
            --text-color: #f0f0f0;
            --accent-color: #51ff7d;
            --highlight-color: #51ff7d;
            --info-box: #d1ecf1; 
            --info-text: #0c5460; 
        }

        body { 
            margin: 0; padding: 0; 
            font-family: 'Nunito', sans-serif; 
            background-color: var(--bg-color); 
            /* Nền chấm bi giống các trang khác */
            background-image: radial-gradient(#333 15%, transparent 16%), radial-gradient(#333 15%, transparent 16%); 
            background-size: 60px 60px; 
            background-position: 0 0, 30px 30px; 
            color: #333; 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            padding-top: 80px; /* Offset cho header fixed */
        }

        /* ⭐ HEADER CHUẨN BOOTSTRAP ⭐ */
        .navbar {
            background: var(--primary-green);
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            backdrop-filter: blur(10px);
        }
        
        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            color: white !important;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-link {
            color: rgba(255,255,255,0.9) !important;
            font-weight: 600;
            margin: 0 5px;
            transition: all 0.3s;
            border-radius: 8px;
        }

        .nav-link:hover, .nav-link.active {
            background-color: rgba(255,255,255,0.2);
            color: #fff !important;
            transform: translateY(-2px);
        }
        
        .navbar-toggler {
            border: none;
            color: white;
            padding: 0.5rem;
        }
        .navbar-toggler:focus {
            box-shadow: none;
            outline: 2px solid var(--accent-color);
        }

        /* BTN GOOGLE LOGIN STYLE */
        .btn-google { 
            background: white; 
            color: #333; 
            border: none; 
            padding: 8px 15px; 
            border-radius: 50px; /* Bo tròn pill */
            font-weight: 700; 
            cursor: pointer; 
            transition: all 0.3s; 
            display: flex; 
            align-items: center; 
            gap: 10px; 
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            font-family: 'Nunito', sans-serif;
        }
        .btn-google:hover { 
            background: #f8f9fa; 
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.3);
        }

        /* MAIN CONTAINER (GLASSMORPHISM) */
        .main-container { flex: 1; display: flex; justify-content: center; align-items: center; padding: 30px 20px; }
        
        .create-card { 
            background: rgba(255, 255, 255, 0.98); 
            width: 100%; 
            max-width: 550px; 
            border-radius: 20px; 
            padding: 40px; 
            box-shadow: 0 20px 50px rgba(0,0,0,0.5); 
            color: #333; 
            position: relative;
        }

        h2 { 
            text-align: center; 
            margin-top: 0; 
            margin-bottom: 30px; 
            font-weight: 800; 
            color: var(--primary-green);
        }

        .form-group { margin-bottom: 25px; }
        
        label { 
            display: block; 
            margin-bottom: 10px; 
            font-weight: 700; 
            color: #444; 
            font-size: 15px; 
        }

        input[type="text"] { 
            width: 100%; 
            padding: 15px; 
            border: 2px solid #e0e0e0; 
            border-radius: 12px; 
            box-sizing: border-box; 
            font-family: 'Nunito', sans-serif;
            font-size: 1rem;
            transition: border-color 0.3s;
        }
        input:focus { border-color: var(--primary-green); outline: none; }

        /* PREVIEW BOX */
        .preview-box { 
            border: 2px dashed #c3e6cb; 
            background-color: #f0fff4; 
            color: #155724; 
            padding: 20px; 
            border-radius: 12px; 
            margin-bottom: 25px; 
            display: none; 
        }
        .preview-box p { margin: 0; font-size: 0.95rem; }
        .preview-box a { color: var(--dark-green); word-break: break-all; font-weight: 600; }

        #finalLinkBox { 
            background: linear-gradient(135deg, #147a30, #0e5a22); 
            color: white; 
            padding: 15px; 
            border-radius: 10px; 
            margin-top: 15px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            gap: 10px;
        }
        
        #finalLinkBox a { color: white; text-decoration: underline; }
        
        .btn-copy-link { 
            background: #fff; 
            color: var(--primary-green); 
            border: none; 
            padding: 8px 15px; 
            border-radius: 8px; 
            cursor: pointer; 
            font-weight: 700;
            white-space: nowrap;
            transition: all 0.2s; 
        }
        .btn-copy-link:hover { background: #f0f0f0; transform: scale(1.05); }

        /* SWITCH TOGGLES */
        .switch-group { display: flex; align-items: center; margin-bottom: 18px; justify-content: space-between; }
        
        .switch-label { 
            display: flex; 
            align-items: center; 
            gap: 15px; 
            font-size: 16px; 
            color: #333; 
            font-weight: 600;
            cursor: pointer; 
        }
        
        .toggle-switch { position: relative; width: 50px; height: 26px; }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #ccc; transition: .4s; border-radius: 34px; }
        .slider:before { position: absolute; content: ""; height: 20px; width: 20px; left: 3px; bottom: 3px; background-color: white; transition: .4s; border-radius: 50%; }
        input:checked + .slider { background-color: var(--primary-green); }
        input:checked + .slider:before { transform: translateX(24px); }

        /* BTN CREATE */
        .btn-create { 
            background: linear-gradient(135deg, #147a30, #0e5a22); 
            color: white; 
            border: none; 
            padding: 15px 30px; 
            font-size: 18px; 
            border-radius: 12px; 
            cursor: pointer; 
            width: 100%; 
            font-weight: 800; 
            transition: 0.3s; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            gap: 12px; 
            margin-top: 10px;
            box-shadow: 0 10px 20px rgba(20, 122, 48, 0.3);
        }
        .btn-create:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 15px 30px rgba(20, 122, 48, 0.4);
            filter: brightness(1.1);
        }

        .info-box { 
            background: #e3f2fd; 
            color: #0d47a1; 
            padding: 15px; 
            border-radius: 10px; 
            margin-top: 25px; 
            font-size: 14px; 
            display: flex; 
            align-items: center; 
            gap: 12px; 
            border-left: 5px solid #2196f3;
        }

        .footer { 
            background: transparent; 
            color: #666; 
            text-align: center; 
            padding: 20px; 
            font-size: 13px; 
            margin-top: auto;
        }

        /* NOTIFICATION */
        #copyNotification {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background-color: #28a745;
            color: white;
            padding: 12px 25px;
            border-radius: 50px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            z-index: 1050;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s cubic-bezier(0.68, -0.55, 0.27, 1.55);
            font-weight: bold;
        }
        #copyNotification.active {
            opacity: 1;
            visibility: visible;
            transform: translateX(-50%) translateY(0);
        }
        
        /* Mobile adjust */
        @media (max-width: 768px) {
            .create-card { padding: 30px 20px; }
            h2 { font-size: 1.5rem; }
            .btn-create { font-size: 16px; }
            
            .user-info-mobile {
                border-top: 1px solid rgba(255,255,255,0.1);
                margin-top: 15px;
                padding-top: 15px;
                justify-content: flex-end;
            }
        }
    </style>
</head>
