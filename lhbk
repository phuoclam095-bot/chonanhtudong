        </div>
        
        <div class="contact-item">
            <div class="contact-icon" style="color: #dc3545;"><i class="fas fa-envelope"></i></div>
            <div class="contact-details">
                <strong>Email Hỗ Trợ</strong>
                <a href="mailto:phuoclam095@gmail.com">phuoclam095@gmail.com</a>
            </div>
        </div>
        
        <p class="mt-4" style="color: #ffeb3b;">
            Thời gian phản hồi thông thường: 8:00 AM - 10:00 PM hàng ngày.
        </p>

    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ⭐ LOGIC JAVASCRIPT CHO NAVIGATION VÀ ĐĂNG XUẤT ⭐
        const adminEmail = localStorage.getItem('admin_email');
        const adminName = localStorage.getItem('admin_name') || 'Admin';
        const isLoggedIn = localStorage.getItem('admin_is_logged_in') === 'true';

        function updateHeaderUI() {
            const authControl = document.getElementById('authControl');
            const userEmailDisplay = document.getElementById('userEmailDisplay');
            
            if (isLoggedIn) {
                userEmailDisplay.innerText = adminName || adminEmail || 'Admin';
                authControl.style.display = 'flex'; 
            } else {
                authControl.style.display = 'none';
            }
        }
        
        function logoutAdmin() {
            localStorage.removeItem('admin_is_logged_in');
            localStorage.removeItem('admin_email');
            localStorage.removeItem('admin_name');
            localStorage.removeItem('google_access_token'); 
            window.location.href = 'admin.html';
        }

        document.addEventListener('DOMContentLoaded', updateHeaderUI);
    </script>
</body>
</html>
