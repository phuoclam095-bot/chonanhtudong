        </div>
        
        <div class="contact-item">
            <div class="contact-icon" style="color: #007bff;">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="currentColor">
                    <path d="M24,4C14.61,4,7,11.61,7,21c0,4.88,2.07,9.28,5.4,12.41l-3.32,7.83l9.66-4.14C20.92,37.67,22.43,38,24,38c9.39,0,17-7.61,17-17S33.39,4,24,4z M33,26h-4v4h-2v-4h-4v-2h4v-4h2v4h4V26z"/>
                </svg>
            </div> 
            <div class="contact-details">
                <strong>Hỗ Trợ Nhanh (Zalo)</strong>
                <a href="https://zalo.me/0879029170" target="_blank">Nhắn Zalo: 0879 029 170</a>
            </div>
        </div>

        <div class="contact-item">
            <div class="contact-icon" style="color: #27A0DF;"><i class="fab fa-telegram"></i></div>
            <div class="contact-details">
                <strong>Hỗ Trợ (Telegram)</strong>
                <a href="tg://resolve?phone=+84836484821" target="_blank">Nhắn Telegram: 0836 484 821</a>
