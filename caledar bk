<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Quản Lý Lịch Chụp</title>
    
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-green: #147a30;
            --dark-green: #0e5a22;
            --accent-gold: #f0c300;
            --bg-dark: #121212;
            --text-light: #f0f0f0;
            --glass-bg: rgba(30, 30, 30, 0.6);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            font-family: 'Nunito', sans-serif;
            min-height: 100vh;
            background-image: radial-gradient(#222 15%, transparent 16%), radial-gradient(#222 15%, transparent 16%);
            background-size: 60px 60px;
            background-position: 0 0, 30px 30px;
            padding-top: 80px; /* Chừa chỗ cho header */
        }

        /* --- HEADER --- */
        .navbar {
            background: var(--primary-green);
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
            backdrop-filter: blur(10px);
        }
        .navbar-brand { font-weight: 800; font-size: 1.2rem; color: white !important; text-transform: uppercase; }
        .nav-link { color: rgba(255,255,255,0.9) !important; font-weight: 600; }

        /* --- LAYOUT CHÍNH --- */
        .main-wrapper {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            display: grid;
            grid-template-columns: 1fr 350px; /* Calendar rộng, Sidebar nhỏ */
            gap: 20px;
        }

        /* --- CALENDAR BOX --- */
        .calendar-container {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .month-year { font-size: 1.5rem; font-weight: 800; color: var(--accent-gold); }
        
        .btn-nav {
            background: rgba(255,255,255,0.1);
            border: none; color: white;
            width: 35px; height: 35px; border-radius: 50%;
            cursor: pointer; transition: 0.3s;
        }
        .btn-nav:hover { background: var(--primary-green); }

        /* GRID LỊCH */
        .weekdays {
            display: grid; grid-template-columns: repeat(7, 1fr);
            text-align: center; font-weight: 700; color: #aaa; margin-bottom: 10px;
        }
        .days {
            display: grid; grid-template-columns: repeat(7, 1fr);
            gap: 10px;
        }

        .day {
            aspect-ratio: 1/1; /* Vuông */
            background: rgba(255,255,255,0.05);
            border-radius: 12px;
            display: flex; flex-direction: column;
            align-items: center; justify-content: flex-start;
            padding-top: 10px;
            cursor: pointer; transition: 0.2s; position: relative;
            border: 1px solid transparent;
        }
        .day:hover { background: rgba(255,255,255,0.15); transform: translateY(-2px); }
        
        /* Ngày hiện tại */
        .day.today { border-color: var(--accent-gold); color: var(--accent-gold); font-weight: bold; background: rgba(240, 195, 0, 0.1); }
        
        /* Ngày được chọn */
        .day.selected { background: var(--primary-green); color: white; border-color: var(--primary-green); }
        
        /* Ngày khác tháng */
        .day.prev-date, .day.next-date { opacity: 0.3; pointer-events: none; }

        /* Dấu chấm báo hiệu có lịch */
        .event-dots {
            display: flex; gap: 3px; margin-top: 5px; flex-wrap: wrap; justify-content: center;
        }
        .dot { width: 6px; height: 6px; background-color: var(--accent-gold); border-radius: 50%; }

        /* --- SIDEBAR (EVENTS LIST) --- */
        .sidebar {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 20px;
            display: flex; flex-direction: column;
            height: fit-content;
            max-height: 80vh;
        }

        .sidebar h3 { font-size: 1.2rem; font-weight: 700; color: var(--accent-gold); margin-bottom: 15px; border-bottom: 1px solid #444; padding-bottom: 10px; }
        
        .selected-date-title { font-size: 1rem; margin-bottom: 15px; color: #ccc; }

        .event-list { overflow-y: auto; flex: 1; padding-right: 5px; }
        
        .event-item {
            background: rgba(0,0,0,0.3);
            border-left: 4px solid var(--primary-green);
            padding: 10px; margin-bottom: 10px;
            border-radius: 5px; position: relative;
        }
        .event-item h4 { font-size: 1rem; margin: 0 0 5px 0; color: white; }
        .event-item p { font-size: 0.85rem; margin: 0; color: #aaa; }
        .event-time { font-weight: bold; color: var(--accent-gold); font-size: 0.8rem; margin-bottom: 3px; display: block;}
        
        .btn-delete-event {
            position: absolute; top: 10px; right: 10px;
            color: #ff6b6b; cursor: pointer; font-size: 0.9rem;
            background: none; border: none;
        }

        .btn-add-event {
            background: linear-gradient(135deg, #147a30, #0e5a22);
            color: white; border: none; padding: 12px;
            border-radius: 10px; font-weight: bold; margin-top: 15px;
            width: 100%; transition: 0.3s;
        }
        .btn-add-event:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(20, 122, 48, 0.4); }

        /* --- MODAL (POPUP THÊM LỊCH) --- */
        .modal-content { background-color: #222; color: white; border: 1px solid #444; }
        .modal-header { border-bottom: 1px solid #444; }
        .modal-footer { border-top: 1px solid #444; }
        .form-control, .form-select { background-color: #333; border: 1px solid #555; color: white; }
        .form-control:focus { background-color: #333; color: white; border-color: var(--accent-gold); box-shadow: none; }

        /* --- MOBILE RESPONSIVE --- */
        @media (max-width: 900px) {
            .main-wrapper { grid-template-columns: 1fr; } /* Chuyển thành 1 cột */
            .sidebar { max-height: none; }
            .day { height: 60px; aspect-ratio: auto; } /* Giảm chiều cao ô ngày trên mobile */
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container-fluid px-3">
            <a class="navbar-brand" href="#"><i class="fas fa-calendar-alt me-2"></i>Lịch Chụp</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a href="managa.html" class="nav-link"><i class="fas fa-arrow-left"></i> Quay lại Dashboard</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="main-wrapper">
        
        <div class="calendar-container">
            <div class="calendar-header">
                <button class="btn-nav" onclick="prevMonth()"><i class="fas fa-chevron-left"></i></button>
                <div class="month-year" id="monthYear">Tháng 12 2025</div>
                <button class="btn-nav" onclick="nextMonth()"><i class="fas fa-chevron-right"></i></button>
            </div>
            
            <div class="weekdays">
                <div>CN</div><div>T2</div><div>T3</div><div>T4</div><div>T5</div><div>T6</div><div>T7</div>
            </div>
            <div class="days" id="daysGrid">
                </div>
        </div>

        <div class="sidebar">
            <h3><i class="fas fa-list-ul me-2"></i>Chi Tiết Lịch</h3>
            <div class="selected-date-title" id="selectedDateDisplay">Chọn một ngày để xem</div>
            
            <div class="event-list" id="eventList">
                <div class="text-center text-muted mt-3">Chưa có lịch chụp nào.</div>
            </div>

            <button class="btn-add-event" onclick="openAddModal()">
                <i class="fas fa-plus-circle me-2"></i> Thêm Lịch Mới
            </button>
        </div>

    </div>

    <div class="modal fade" id="addEventModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-warning"><i class="fas fa-camera me-2"></i>Đặt Lịch Chụp</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="addEventForm">
                        <div class="mb-3">
                            <label class="form-label">Tên Khách Hàng</label>
                            <input type="text" class="form-control" id="clientName" placeholder="Ví dụ: Chị Lan, Anh Tuấn..." required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Gói Chụp / Loại</label>
                            <select class="form-select" id="shootType">
                                <option value="Cưới (Wedding)">💍 Chụp Cưới (Wedding)</option>
                                <option value="Tiệc (Party)">🎉 Chụp Tiệc / Sự Kiện</option>
                                <option value="Chân Dung (Portrait)">📸 Chân Dung / Profile</option>
                                <option value="Gia Đình (Family)">👨‍👩‍👧‍👦 Chụp Gia Đình</option>
                                <option value="Khác">🔹 Khác</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Thời Gian</label>
                            <input type="time" class="form-control" id="eventTime" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ghi Chú</label>
                            <textarea class="form-control" id="eventNote" rows="2" placeholder="Địa điểm, yêu cầu đặc biệt..."></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-success" onclick="saveEvent()">Lưu Lịch</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // --- LOGIC LỊCH ---
        const date = new Date();
        let currentMonth = date.getMonth();
        let currentYear = date.getFullYear();
        let selectedDate = new Date(); // Mặc định chọn hôm nay

        const monthYearEl = document.getElementById('monthYear');
        const daysGridEl = document.getElementById('daysGrid');
        const eventListEl = document.getElementById('eventList');
        const selectedDateDisplay = document.getElementById('selectedDateDisplay');
        const modal = new bootstrap.Modal(document.getElementById('addEventModal'));

        // Dữ liệu mẫu (Lưu trong LocalStorage)
        // Cấu trúc: { "YYYY-MM-DD": [ {name, type, time, note}, ... ] }
        let events = JSON.parse(localStorage.getItem('photo_calendar_events')) || {};

        const months = [
            "Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4", "Tháng 5", "Tháng 6",
            "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12"
        ];

        // 1. RENDER LỊCH
        function renderCalendar() {
            date.setDate(1);
            const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay();
            const lastDay = new Date(currentYear, currentMonth + 1, 0).getDate();
            const prevLastDay = new Date(currentYear, currentMonth, 0).getDate();
            const lastDayIndex = new Date(currentYear, currentMonth + 1, 0).getDay();
            const nextDays = 7 - lastDayIndex - 1;

            monthYearEl.innerText = `${months[currentMonth]} ${currentYear}`;

            let days = "";

            // Ngày tháng trước
            for (let x = firstDayIndex; x > 0; x--) {
                days += `<div class="day prev-date">${prevLastDay - x + 1}</div>`;
            }

            // Ngày tháng hiện tại
            for (let i = 1; i <= lastDay; i++) {
                const dateKey = formatDateKey(currentYear, currentMonth, i);
                const hasEvent = events[dateKey] && events[dateKey].length > 0;
                
                // Check today
                const isToday = i === new Date().getDate() && 
                                currentMonth === new Date().getMonth() && 
                                currentYear === new Date().getFullYear();
                
                // Check selected
                const isSelected = i === selectedDate.getDate() &&
                                   currentMonth === selectedDate.getMonth() &&
                                   currentYear === selectedDate.getFullYear();

                let dotsHtml = '';
                if (hasEvent) {
                    const count = Math.min(events[dateKey].length, 3); // Max 3 dots
                    for(let d=0; d<count; d++) dotsHtml += `<div class="dot"></div>`;
                }

                days += `<div class="day ${isToday ? 'today' : ''} ${isSelected ? 'selected' : ''}" onclick="selectDate(${i})">
                            ${i}
                            <div class="event-dots">${dotsHtml}</div>
                         </div>`;
            }

            // Ngày tháng sau
            for (let j = 1; j <= nextDays + 1; j++) { // +1 vì index 0 là CN
                 // Fix nhẹ logic hiển thị ngày tháng sau cho đẹp grid
                 if(days.split('class="day').length < 35) { // Nếu ít hàng quá thì thêm
                     // Logic này có thể tinh chỉnh sau
                 }
                 // Tạm thời để đơn giản
            }

            daysGridEl.innerHTML = days;
            renderEventList();
        }

        // 2. CHỌN NGÀY
        function selectDate(day) {
            selectedDate = new Date(currentYear, currentMonth, day);
            renderCalendar(); // Re-render để highlight
        }

        // 3. RENDER DANH SÁCH SỰ KIỆN BÊN PHẢI
        function renderEventList() {
            const dateKey = formatDateKey(selectedDate.getFullYear(), selectedDate.getMonth(), selectedDate.getDate());
            const dayEvents = events[dateKey] || [];

            // Format hiển thị ngày tiêu đề
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            selectedDateDisplay.innerText = selectedDate.toLocaleDateString('vi-VN', options);

            if (dayEvents.length === 0) {
                eventListEl.innerHTML = `<div class="text-center text-muted mt-4"><i class="far fa-calendar-times fa-2x mb-2"></i><br>Không có lịch chụp.</div>`;
            } else {
                let html = '';
                dayEvents.sort((a, b) => a.time.localeCompare(b.time)); // Sắp xếp theo giờ

                dayEvents.forEach((ev, index) => {
                    html += `
                        <div class="event-item">
                            <span class="event-time"><i class="far fa-clock me-1"></i>${ev.time}</span>
                            <h4>${ev.client}</h4>
                            <p class="text-white-50"><i class="fas fa-camera me-1"></i>${ev.type}</p>
                            ${ev.note ? `<p style="font-style:italic">"${ev.note}"</p>` : ''}
                            <button class="btn-delete-event" onclick="deleteEvent('${dateKey}', ${index})">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    `;
                });
                eventListEl.innerHTML = html;
            }
        }

        // 4. THÊM SỰ KIỆN
        function openAddModal() {
            // Reset form
            document.getElementById('addEventForm').reset();
            modal.show();
        }

        function saveEvent() {
            const name = document.getElementById('clientName').value;
            const type = document.getElementById('shootType').value;
            const time = document.getElementById('eventTime').value;
            const note = document.getElementById('eventNote').value;

            if (!name || !time) {
                alert("Vui lòng nhập tên khách và giờ chụp!");
                return;
            }

            const dateKey = formatDateKey(selectedDate.getFullYear(), selectedDate.getMonth(), selectedDate.getDate());

            if (!events[dateKey]) events[dateKey] = [];
            
            events[dateKey].push({
                client: name,
                type: type,
                time: time,
                note: note
            });

            // Lưu LocalStorage
            localStorage.setItem('photo_calendar_events', JSON.stringify(events));

            modal.hide();
            renderCalendar(); // Cập nhật lại Grid (thêm chấm) và List
            // alert("Đã thêm lịch thành công!");
        }

        // 5. XÓA SỰ KIỆN
        function deleteEvent(dateKey, index) {
            if (confirm("Bạn có chắc muốn xóa lịch chụp này?")) {
                events[dateKey].splice(index, 1);
                // Nếu rỗng thì xóa key luôn cho sạch
                if (events[dateKey].length === 0) delete events[dateKey];
                
                localStorage.setItem('photo_calendar_events', JSON.stringify(events));
                renderCalendar();
            }
        }

        // 6. ĐIỀU HƯỚNG THÁNG
        function prevMonth() {
            currentMonth--;
            if (currentMonth < 0) {
                currentMonth = 11;
                currentYear--;
            }
            renderCalendar();
        }

        function nextMonth() {
            currentMonth++;
            if (currentMonth > 11) {
                currentMonth = 0;
                currentYear++;
            }
            renderCalendar();
        }

        // UTILS
        function formatDateKey(year, month, day) {
            // Tạo key dạng YYYY-MM-DD để dễ lưu
            return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        }

        // INIT
        document.addEventListener('DOMContentLoaded', () => {
            renderCalendar();
        });

    </script>
</body>
</html>
